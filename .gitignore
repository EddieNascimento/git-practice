# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Environment / secrets ---
# Never commit real env files — only checked-in *.example templates.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets.yml
secrets.yaml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
dist/
build/
.next/
.nuxt/
coverage/

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# --- direnv ---
.direnv/
.envrc.local

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
